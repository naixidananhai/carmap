# 用法：复制本文件为 .env 并填入真实值；.env 已被 gitignore，不会上传。

# ============ 地图数据源选择 ============
# amap      高德（推荐）：/v3/distance 按【请求次数】计费，个人认证免费 15 万次/月
# baidu     百度：/routematrix 按【路线条数】计费，30 人一次任务消耗 930 条
# haversine 直线距离（离线兜底，不调外部 API，精度明显下降）
# 首选数据源密钥缺失或接口不可用时，会自动降级到下一级
MAP_PROVIDER=amap

# ============ 高德地图（MAP_PROVIDER=amap 时必需）============
# 申请地址：https://console.amap.com/dev/key/app （选「Web服务」类型）
AMAP_KEY=your_amap_key_here

# ============ 百度地图（MAP_PROVIDER=baidu 时必需）============
# 申请地址：https://lbsyun.baidu.com/apiconsole/key （服务端 SN 签名）
BAIDU_MAP_AK=your_baidu_map_ak_here
BAIDU_MAP_SK=your_baidu_map_sk_here
